# ============================================================
# QueroLink — Variáveis de Ambiente (.env.example)
# Copie para .env e preencha os valores reais.
# NUNCA comitar o .env com valores reais.
# ============================================================
# INSTRUÇÃO: descomente apenas o que for usar.
# Variáveis marcadas como [OBRIGATÓRIO] são necessárias
# para o funcionamento mínimo do sistema.
# ============================================================


# ═══════════════════════════════════════════════════════════════
# [OBRIGATÓRIO] Django Core
# ═══════════════════════════════════════════════════════════════
DEBUG=False
SECRET_KEY=sua-chave-secreta-muito-segura-aqui
ALLOWED_HOSTS=vcom.vidalys.com.br
DJANGO_SETTINGS_MODULE=app.config.settings.production


# ═══════════════════════════════════════════════════════════════
# [OBRIGATÓRIO] Banco de Dados (PostgreSQL)
# ═══════════════════════════════════════════════════════════════
DATABASE_URL=postgres://usuario:senha@host:5432/querolink
# CONN_MAX_AGE=600
# DB_SSL_REQUIRE=True


# ═══════════════════════════════════════════════════════════════
# [OBRIGATÓRIO] Redis / Celery
# ═══════════════════════════════════════════════════════════════
REDIS_URL=redis://:sua_senha_redis@localhost:6379/0
# REDIS_PASSWORD=sua_senha_redis


# ═══════════════════════════════════════════════════════════════
# [OBRIGATÓRIO] URLs do sistema
# ═══════════════════════════════════════════════════════════════
SERVICE_FQDN_WEB=vcom.vidalys.com.br
CSRF_TRUSTED_ORIGINS=https://vcom.vidalys.com.br
CORS_ALLOWED_ORIGINS=https://vcom.vidalys.com.br


# ═══════════════════════════════════════════════════════════════
# [OBRIGATÓRIO] WhatsApp (Evolution API)
# ═══════════════════════════════════════════════════════════════
WHATSAPP_API_KEY=sua_chave_global_evolution_api
WHATSAPP_API_BASE_URL=https://sua-evolution-api.exemplo.com.br
# WHATSAPP_INSTANCE=bibelo
# True apenas em instalacoes de tenant unico. Com False (padrao),
# cada tenant precisa ter sua propria instancia WhatsApp configurada
# em Configuracoes. Nunca ative em producao multi-tenant.
# WHATSAPP_ALLOW_SHARED_INSTANCE=False


# ═══════════════════════════════════════════════════════════════
# [OBRIGATÓRIO] Superuser (criado automaticamente)
# ═══════════════════════════════════════════════════════════════
DJANGO_SUPERUSER_EMAIL=admin@vidalys.com.br
DJANGO_SUPERUSER_PASSWORD=senha-superuser-muito-segura


# ═══════════════════════════════════════════════════════════════
# [OPCIONAL] Segurança
# ═══════════════════════════════════════════════════════════════

# Força autenticação Basic Auth nos webhooks do Pagar.me
# Desative apenas durante migração inicial
# WEBHOOK_AUTH_REQUIRED=True

# Força redirect HTTPS (production)
# SECURE_SSL_REDIRECT=True

# Cookies seguros (production)
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# HSTS (production)
# SECURE_HSTS_SECONDS=31536000

# Chave dedicada para encriptação Fernet (se vazio, deriva da SECRET_KEY)
# FERNET_KEY=

# Chave dedicada para JWT (se vazio, usa SECRET_KEY)
# JWT_SIGNING_KEY=


# ═══════════════════════════════════════════════════════════════
# [OPCIONAL] JWT
# ═══════════════════════════════════════════════════════════════
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
# JWT_REFRESH_TOKEN_LIFETIME_DAYS=7


# ═══════════════════════════════════════════════════════════════
# [OPCIONAL] Gunicorn
# ═══════════════════════════════════════════════════════════════
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=120


# ═══════════════════════════════════════════════════════════════
# [OPCIONAL] Email (SMTP)
# ═══════════════════════════════════════════════════════════════
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.seuprovedor.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=seu-email@dominio.com
# EMAIL_HOST_PASSWORD=sua-senha-smtp
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@seudominio.com


# ═══════════════════════════════════════════════════════════════
# [OPCIONAL] Billing / Assinaturas (Mercado Pago)
# Deixe tudo comentado se nao for usar faturamento recorrente.
# O sistema funciona COMPLETO sem essas variaveis.
# ═══════════════════════════════════════════════════════════════
# MP_ACCESS_TOKEN=
# MP_PUBLIC_KEY=
# MP_WEBHOOK_SECRET=
# PLAN_PRICE_STARTER=9700
# PLAN_PRICE_PRO=24700
# PLAN_PRICE_ENTERPRISE=49700


# ═══════════════════════════════════════════════════════════════
# [OPCIONAL] Seed / Staging
# ═══════════════════════════════════════════════════════════════
# SEED_ON_START=false
# API_KEY_PAGAR_ME=  # chave pagarme para o tenant inicial (seed)
# INSTANCE=          # legado — usar WHATSAPP_INSTANCE
# API_KEY_INSTANCIA= # legado — usar WHATSAPP_API_KEY


# ═══════════════════════════════════════════════════════════════
# [OPCIONAL] Logging
# ═══════════════════════════════════════════════════════════════
# LOG_LEVEL=WARNING


# ═══════════════════════════════════════════════════════════════
# [OPCIONAL] Backup (rclone)
# Não requer variáveis — configure via:
#   docker exec -it <container> ./scripts/setup-rclone.sh
# ═══════════════════════════════════════════════════════════════
