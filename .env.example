# ============================================================
# QueroLink — Variáveis de Ambiente (.env)
# Copie para .env e preencha os valores reais.
# ============================================================

# ── Django ─────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=sua-chave-secreta-muito-segura-aqui
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=app.config.settings.production

# ── Banco de Dados ─────────────────────────────────────────
# Local (SQLite): deixar DATABASE_URL vazio, usa db.sqlite3
# PostgreSQL (prod/staging):
DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_SSL_REQUIRE=True  # desabilitar apenas se banco na mesma rede privada

# ── Redis / Celery ─────────────────────────────────────────
REDIS_URL=redis://:sua_senha_redis@localhost:6379/0
REDIS_PASSWORD=sua_senha_redis

# ── APIs Externas ──────────────────────────────────────────
API_KEY_PAGAR_ME=sua_chave_pagar_me

# Evolution API (WhatsApp) — chave GLOBAL do sistema
# Esta chave pertence a plataforma e e usada para CRIAR instancias
# Cada tenant conecta seu proprio WhatsApp via QR Code com nome de instancia unico
WHATSAPP_API_KEY=sua_chave_global_evolution_api
WHATSAPP_API_BASE_URL=https://api.lojabibelo.com.br
# Opcional: nome de instancia padrao (tenant pode sobrescrever nas configuracoes)
# WHATSAPP_INSTANCE=

# ── JWT ────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Deploy ─────────────────────────────────────────────────
# Produção: SEED_ON_START=false (não popular banco)
# Staging/Demo: SEED_ON_START=true (criar vendedores de teste)
SEED_ON_START=false

# ── Gunicorn ───────────────────────────────────────────────
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# ── URLs (Coolify) ─────────────────────────────────────────
SERVICE_URL_WEB=http://localhost:8000
SERVICE_FQDN_WEB=localhost

# ── Encriptacao (fernet) ────────────────────────────────────
# FORTEMENTE RECOMENDADO: gere uma chave dedicada com o comando abaixo
# e configure aqui. Sem ela, o sistema deriva uma chave da SECRET_KEY
# (funciona, mas dificulta rotacao futura).
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ── Backup (Google Drive via rclone) ────────────────────────
# ============================================================
# Backup automatico diario do PostgreSQL para Google Drive.
# Custo: R$ 0 (15 GB gratuitos).
# Guia completo: docs/GOOGLE_DRIVE_CREDENTIALS.md
# ============================================================
#
# Setup unico (3 min): docker exec -it <container> ./scripts/setup-rclone.sh
#
# O que acontece automaticamente:
#   - 02:00: pg_dump -Fc -Z9 comprime o banco (~5 MB)
#   - 02:00: rclone sobe o dump para o Google Drive
#   - 02:00: remove backups locais > 2 dias
#   - 02:00: remove backups no Drive > 30 dias
#
# Configuracoes do rclone (geralmente nao precisa alterar):
# GDRIVE_REMOTE=gdrive
# GDRIVE_PATH=querolink-backups
