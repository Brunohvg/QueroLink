# ============================================================
# QueroLink — Variáveis de Ambiente (.env.example)
# Copie para .env e preencha os valores reais.
# NUNCA comitar o .env com valores reais.
# ============================================================


# ── Django Core ──────────────────────────────────────────────
# ATENÇÃO: em produção, DEBUG=False e SECRET_KEY deve ser
# uma string aleatória de pelo menos 50 caracteres.
DEBUG=True
SECRET_KEY=sua-chave-secreta-muito-segura-aqui
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=app.config.settings.production


# ── Banco de Dados ───────────────────────────────────────────
# Local (SQLite): deixar vazio ou comentar, usa db.sqlite3
# PostgreSQL (prod/staging):
# DATABASE_URL=postgres://user:password@host:5432/dbname
# CONN_MAX_AGE=600
# DB_SSL_REQUIRE=True


# ── Redis / Celery ───────────────────────────────────────────
REDIS_URL=redis://:sua_senha_redis@localhost:6379/0
REDIS_PASSWORD=sua_senha_redis


# ── WhatsApp (Evolution API) ─────────────────────────────────
# Chave GLOBAL da plataforma. Usada para criar instâncias.
# Cada lojista conecta seu próprio WhatsApp via QR Code.
WHATSAPP_API_KEY=sua_chave_global_evolution_api
WHATSAPP_API_BASE_URL=https://api.lojabibelo.com.br
# Opcional: instância padrão (tenant pode sobrescrever)
# WHATSAPP_INSTANCE=bibelo


# ── Billing / Assinaturas (Pagar.me — chave DO VIDALYS) ──────
PLAN_PRICE_ESSENCIAL=0
PLAN_PRICE_PROFISSIONAL=0
PLAN_PRICE_PLUS=0
PLAN_PRICE_ENTERPRISE=0
VIDALYS_PAGARME_API_KEY=
VIDALYS_PAGARME_PUBLIC_KEY=
BILLING_WEBHOOK_USER=
BILLING_WEBHOOK_PASS=


# ── Webhook Auth ────────────────────────────────────────────
WEBHOOK_AUTH_REQUIRED=True


# ── URLs ─────────────────────────────────────────────────────
SERVICE_FQDN_WEB=localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000


# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# FORTEMENTE RECOMENDADO: gere uma chave dedicada com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Sem ela, o sistema usa SECRET_KEY (funciona mas dificulta rotação independente).
JWT_SIGNING_KEY=


# ── Gunicorn ─────────────────────────────────────────────────
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120


# ── Encriptação (Fernet) ─────────────────────────────────────
# FORTEMENTE RECOMENDADO: gere uma chave dedicada com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sem ela, o sistema deriva da SECRET_KEY (funciona mas dificulta rotação).
FERNET_KEY=


# ── Superuser (criado automaticamente se não existir) ─────────
DJANGO_SUPERUSER_EMAIL=admin@exemplo.com
DJANGO_SUPERUSER_PASSWORD=senha-superuser-muito-segura


# ── Email (SMTP — opcional) ──────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=


# ── Seed (apenas staging/dev) ────────────────────────────────
SEED_ON_START=false


# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=WARNING


# ── Backup (Google Drive via rclone) ─────────────────────────
# Setup único (3 minutos):
#   docker exec -it <container-web> ./scripts/setup-rclone.sh
#
# Guia completo: docs/GOOGLE_DRIVE_CREDENTIALS.md
# Custo: R$ 0 (15 GB gratuitos)
#
# O backup roda automaticamente às 02:00 via Celery Beat.
# Não requer variáveis — o rclone armazena credenciais no container.
