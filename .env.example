# ============================================================
# QueroLink — Variáveis de Ambiente (.env)
# Copie para .env e preencha os valores reais.
# ============================================================

# ── Django ─────────────────────────────────────────────────
# Desenvolvimento: DJANGO_SETTINGS_MODULE=app.config.settings.local
# Produção: DJANGO_SETTINGS_MODULE=app.config.settings.production
DEBUG=False
SECRET_KEY=sua-chave-secreta-muito-segura-aqui
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=app.config.settings.local

# ── Banco de Dados ─────────────────────────────────────────
# Local (SQLite): deixar DATABASE_URL vazio, usa db.sqlite3
# PostgreSQL (prod/staging):
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ── Redis / Celery ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── APIs Externas ──────────────────────────────────────────
API_KEY_PAGAR_ME=sua_chave_pagar_me
API_KEY_INSTANCIA=sua_chave_whatsapp
INSTANCE=nome_da_instancia_whatsapp

# ── JWT ────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── CORS (origens permitidas para API) ──────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── CSRF (origens confiáveis) ──────────────────────────────
CSRF_TRUSTED_ORIGINS=https://querolink.lojabibelo.com.br,https://www.querolink.lojabibelo.com.br

# ── SSL/HTTPS (default True em produção) ────────────────────
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# ── Deploy ─────────────────────────────────────────────────
# Produção: SEED_ON_START=false (não popular banco)
# Staging/Demo: SEED_ON_START=true (criar 16 vendedores de teste)
SEED_ON_START=false

# ── Gunicorn ───────────────────────────────────────────────
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# ── URLs (Coolify) ─────────────────────────────────────────
SERVICE_URL_WEB=http://localhost:8000
SERVICE_FQDN_WEB=localhost
