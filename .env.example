# ============================================================
# Mérito by Vidalys — .env.example
# ============================================================
# Copie este arquivo para .env e preencha os valores.
#
# Variáveis marcadas com 🔴 são OBRIGATÓRIAS (crash sem elas).
# Variáveis marcadas com 🟠 são RECOMENDADAS (funcionalidade quebrada sem).
# Variáveis marcadas com 🟡 são OPCIONAIS (degradação silenciosa).
# Variáveis sem marcador têm default razoável e são opcionais.
#
# ⚠️  NUNCA comitar o .env real no Git.
# ============================================================


# ═══════════════════════════════════════════════════════════════
# 1. DJANGO CORE
# ═══════════════════════════════════════════════════════════════

# 🔴 Chave secreta do Django. Use no mínimo 50 caracteres aleatórios.
#    Gerar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=substitua-por-uma-chave-segura-de-64-caracteres

# Ambiente: True = desenvolvimento, False = produção
#    Produção sempre False.
DEBUG=False

# Domínios onde o Django aceita requisições (separados por vírgula).
#    Em produção, liste TODOS os domínios (com e sem www, subdomínios).
#    Ex: meudominio.com.br,www.meudominio.com.br,app.meudominio.com.br
ALLOWED_HOSTS=localhost,127.0.0.1

# Módulo de settings. Não mude a menos que saiba o que está fazendo.
#    Opções: app.config.settings.local (dev) | app.config.settings.production
DJANGO_SETTINGS_MODULE=app.config.settings.local


# ═══════════════════════════════════════════════════════════════
# 2. BANCO DE DADOS (PostgreSQL)
# ═══════════════════════════════════════════════════════════════

# 🔴 URL de conexão PostgreSQL.
#    Formato: postgres://USUARIO:SENHA@HOST:PORTA/NOME_DB
#    Exemplo local: postgres://postgres:postgres@localhost:5432/querolink
DATABASE_URL=postgres://postgres:postgres@localhost:5432/querolink

# Tempo máximo (segundos) que uma conexão com o banco fica aberta.
#    600 = 10 minutos. Aumente para reduzir overhead de reconexão.
CONN_MAX_AGE=600

# Exige SSL na conexão com o banco? Em produção com DB remoto = True.
#    Se o banco estiver no mesmo servidor/docker, pode ser False.
DB_SSL_REQUIRE=False


# ═══════════════════════════════════════════════════════════════
# 3. REDIS / CELERY
# ═══════════════════════════════════════════════════════════════

# 🔴 URL do Redis (broker e cache do Celery + cache Django).
#    Formato: redis://:SENHA@HOST:PORTA/NUMERO_DB
#    Sem senha: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Senha do Redis (usada apenas no healthcheck, opcional).
#    Se o REDIS_URL já inclui senha, esta é redundante.
REDIS_PASSWORD=


# ═══════════════════════════════════════════════════════════════
# 4. WHATSAPP (Evolution API)
# ═══════════════════════════════════════════════════════════════

# 🟠 API Key GLOBAL da plataforma Evolution API.
#    Você encontra no painel do Evolution API (Settings > API Key).
WHATSAPP_API_KEY=

# 🟠 Nome da instância GLOBAL do Evolution API.
#    Opcional: cada lojista pode conectar sua própria instância
#    via QR Code na dashboard (Configurações > WhatsApp).
WHATSAPP_INSTANCE=

# URL base do Evolution API (sem barra no final).
#    Exemplo self-hosted:  https://api.meudominio.com.br
#    Exemplo local dev:    http://localhost:8080
WHATSAPP_API_BASE_URL=

# Permite que lojistas sem instância própria usem a instância global?
#    True  = compartilhar instância (dev/staging)
#    False = cada lojista precisa conectar o próprio WhatsApp (produção)
WHATSAPP_ALLOW_SHARED_INSTANCE=False

# ⚠️  Legado — remova se não usa. Estas variáveis são fallback
#    se WHATSAPP_API_KEY e WHATSAPP_INSTANCE não forem definidas:
# API_KEY_INSTANCIA=
# INSTANCE=


# ═══════════════════════════════════════════════════════════════
# 5. URLS E DOMÍNIOS
# ═══════════════════════════════════════════════════════════════

# Hostname principal (sem https://, sem barra).
#    Usado em links de emails, WhatsApp, etc.
#    Exemplo: app.meudominio.com.br
SERVICE_FQDN_WEB=localhost

# Origens confiáveis para CSRF (separados por vírgula).
#    Liste TODOS os domínios incluindo https://.
#    Exemplo: https://meudominio.com.br,https://www.meudominio.com.br
CSRF_TRUSTED_ORIGINS=

# Origens permitidas para CORS (separados por vírgula).
#    Necessário se o frontend estiver em domínio diferente.
CORS_ALLOWED_ORIGINS=


# ═══════════════════════════════════════════════════════════════
# 6. JWT (JSON Web Token — autenticação API)
# ═══════════════════════════════════════════════════════════════

# Duração do token de acesso em minutos. 30 = meia hora.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30

# Duração do token de refresh em dias. 7 = uma semana.
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# 🔴 Chave de assinatura JWT, obrigatória e distinta da SECRET_KEY em produção.
#    Gerar: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SIGNING_KEY=substitua-por-uma-chave-jwt-diferente-da-secret-key


# ═══════════════════════════════════════════════════════════════
# 7. ENCRIPTAÇÃO (Fernet)
# ═══════════════════════════════════════════════════════════════

# 🔴 Chave Fernet para criptografar dados sensíveis (telefones, chaves).
#    Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=


# ═══════════════════════════════════════════════════════════════
# 8. E-MAIL (SMTP)
# ═══════════════════════════════════════════════════════════════

# Backend de e-mail:
#    Dev:  django.core.mail.backends.console.EmailBackend (imprime no console)
#    Prod: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Servidor SMTP (ex: smtp.gmail.com, smtp.sendgrid.net, smtp.hostinger.com)
EMAIL_HOST=

# Porta SMTP (587 = TLS, 465 = SSL, 25 = plain)
EMAIL_PORT=587

# Credenciais SMTP
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Usar TLS? True para porta 587.
EMAIL_USE_TLS=True

# Remetente padrão dos e-mails do sistema.
#    Deve ser um e-mail verificado no seu provedor SMTP.
DEFAULT_FROM_EMAIL=noreply@seudominio.com.br

SERVER_EMAIL
# ═══════════════════════════════════════════════════════════════
# 9. MERCADO PAGO (assinaturas)
# ═══════════════════════════════════════════════════════════════

# 🟠 Access Token (privado) — gerado no painel do Mercado Pago.
#    Painel > Suas integrações > Credenciais > Access Token (produção).
MP_ACCESS_TOKEN=

# 🟠 Public Key (pública) — gerada no painel do Mercado Pago.
#    Necessária pro checkout funcionar no frontend.
#    Painel > Suas integrações > Credenciais > Public Key.
MP_PUBLIC_KEY=

# Segredo do Webhook do Mercado Pago (opcional — valida assinatura).
#    Painel > Suas integrações > Webhooks > Chave secreta.
MP_WEBHOOK_SECRET=


# ═══════════════════════════════════════════════════════════════
# 10. PLANOS (preços em centavos) — ATENÇÃO COM A LANDING PAGE
# ═══════════════════════════════════════════════════════════════
#
# ⚠️  Se alterar estes valores, ATUALIZE TAMBÉM:
#     - templates/accounts/landing.html (seção de planos)
#     - templates/dashboard/assinatura.html (valores exibidos)
#
#     O código da landing page NÃO lê estas variáveis —
#     os preços estão hardcoded. Divergência entre oferta
#     e cobrança real pode causar problemas legais.
#
#     Valores padrão:
#       Starter:  R$ 147/mês  (14700 centavos)
#       Pro:      R$ 297/mês  (29700 centavos)
#       Business: R$ 497/mês  (49700 centavos)
#
#     Anual = 10 × mensal (2 meses grátis)

PLAN_PRICE_STARTER=24700
PLAN_PRICE_PRO=49700
PLAN_PRICE_BUSINESS=89700


# ═══════════════════════════════════════════════════════════════
# 11. WEB PUSH (VAPID — notificações no celular do vendedor)
# ═══════════════════════════════════════════════════════════════

# 🟡 Chave pública VAPID. Sem ela, push notifications no celular
#    do vendedor não funcionam. Degradação silenciosa.
#    Gerar: pip install pywebpush && pywebpush genkey
VAPID_PUBLIC_KEY=

# 🟡 Chave privada VAPID (mantenha em segredo).
VAPID_PRIVATE_KEY=

# E-mail de contato para o serviço de push.
VAPID_CONTACT_EMAIL=contato@seudominio.com.br

# 🟢 Libera a Central de Clientes depois da homologação da funcionalidade.
CUSTOMER_LEDGER_UI_ENABLED=False


# ═══════════════════════════════════════════════════════════════
# 12. SEGURANÇA (produção)
# ═══════════════════════════════════════════════════════════════
#    Estas só têm efeito com settings de produção.

# Redirecionar HTTP → HTTPS?
#    True em produção com certificado SSL.
#    False se estiver atrás de reverse proxy que já faz isso.
SECURE_SSL_REDIRECT=True

# Cookies de sessão apenas via HTTPS?
SESSION_COOKIE_SECURE=True

# Cookie CSRF apenas via HTTPS?
CSRF_COOKIE_SECURE=True

# Tempo máximo (segundos) do header HSTS (HTTP Strict Transport Security).
#    31536000 = 1 ano. Só ative com HTTPS 100% funcional.
SECURE_HSTS_SECONDS=31536000

# Exigir autenticação nos webhooks?
#    True = só aceita webhooks com Basic Auth (recomendado).
WEBHOOK_AUTH_REQUIRED=True


# ═══════════════════════════════════════════════════════════════
# 13. SUPERUSER (criação automática)
# ═══════════════════════════════════════════════════════════════

# E-mail do superusuário criado automaticamente no primeiro boot.
#    Só usado se não existir nenhum superuser no banco.
DJANGO_SUPERUSER_EMAIL=admin@seudominio.com.br

# Senha do superusuário. Troque após o primeiro login.
DJANGO_SUPERUSER_PASSWORD=


# ═══════════════════════════════════════════════════════════════
# 14. GUNICORN (servidor de produção)
# ═══════════════════════════════════════════════════════════════

# Número de workers (processos). Regra prática: (2 × CPUs) + 1.
GUNICORN_WORKERS=3

# Timeout em segundos. Aumente para tarefas longas (ex: export).
GUNICORN_TIMEOUT=120

# ═══════════════════════════════════════════════════════════════
# 15. LOGGING
# ═══════════════════════════════════════════════════════════════

# Nível de log. Opções: DEBUG, INFO, WARNING, ERROR, CRITICAL.
#    Produção: WARNING. Dev/staging: INFO ou DEBUG.
LOG_LEVEL=WARNING


# ============================================================
# 17. SENTRY (observabilidade de erros — opcional, recomendado em producao)
# ============================================================
# DSN do projeto no sentry.io (Settings > Client Keys). Vazio = desligado.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1


# ═══════════════════════════════════════════════════════════════
# 18. BACKUP (PostgreSQL → Google Drive via rclone)
# ═══════════════════════════════════════════════════════════════

# 🔴 Rclone remote para Google Drive. Deve ser "drive" (valor do TYPE).
#    Configuracao: https://rclone.org/drive/
RCLONE_CONFIG_GDRIVE_TYPE=drive

# Escopo do Google Drive. O padrao "drive" da acesso completo.
#    drive.file = acesso apenas a arquivos criados pelo app.
RCLONE_CONFIG_GDRIVE_SCOPE=drive

# 🔴 Token de acesso do Google Drive (JSON gerado pelo rclone authorize).
#    Obter: rclone authorize "drive" "SEU_CLIENT_ID" "SEU_CLIENT_SECRET"
#    ⚠️  NUNCA comitar o token real no Git.
RCLONE_CONFIG_GDRIVE_TOKEN={"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}

# Caminho da pasta de backups no Google Drive.
GDRIVE_PATH=querolink-backups

# Dias de retencao dos backups locais (default: 2).
# LOCAL_RETENTION_DAYS=2

# Dias de retencao dos backups remotos no Google Drive (default: 30).
# REMOTE_RETENTION_DAYS=30
